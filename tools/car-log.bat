@echo off
chcp 65001 >nul
set PYTHONUTF8=1
set PYTHONIOENCODING=utf-8
rem 在脚本所在目录的上一级运行（这样整个 tools 文件夹复制到别的电脑也能用）
cd /d "%~dp0.."
echo ============================================================
echo   阿特兹仪表 - 车上抓日志（Python 版）
echo   自动识别串口，日志存到 backup\car-log-年月日-时分秒.txt
echo   默认抓 1 小时；Ctrl+C 可提前结束
echo ============================================================
echo.
python "%~dp0car-log.py" %*
echo.
echo ============================================================
echo   已结束。日志在 backup\ 目录里。
echo ============================================================
pause
