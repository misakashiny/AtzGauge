+ *   1. delete this block,
+ *   2. delete the two calls tagged [ATZ_SYNTH_RPM] in my_timerMain() and ui_init(),
+ *   3. delete the boot-page override tagged [ATZ_SYNTH_RPM] in ui_ext.c,
+ *   4. set ATZ_SYNTH_RPM to 0 in ui_ext.h (or delete it),
+ *   5. rebuild and re-flash.
+ * ========================================================================== */
+// ATZ_SYNTH_RPM is defined in ui_ext.h (shared with ui_ext.c)
+
+#if ATZ_SYNTH_RPM
+// (esp_timer.h is already included at the top of this file)
+
+// Triangular 0..peak rpm, one full up+down period per ATZ_SYNTH_PERIOD_MS.
+#define ATZ_SYNTH_PEAK      4000   // rpm peak of the ramp
+#define ATZ_SYNTH_PERIOD_MS 4000   // full up+down cycle, ms (2 s up, 2 s down)
+#define ATZ_SYNTH_FEED_HZ   10     // how often a "fresh" OBD sample appears (ELM327-realistic)
+
+// Push the synthetic value into the snapshot so the whole downstream pipeline
+// (ui_build_theme_snapshot / gear calc / warning logic) sees a consistent car.
+//
+// RPM uses the firmware's own override hook (obd_data_rpm_override_set), because
+// obd_data_get_snapshot() returns the override value when it is enabled, while
+// obd_data_set_rpm() -- which only writes the internal s_rpm_smooth -- would be
+// overwritten by the BLE reader's next real sample. Speed needs no such hook:
+// with no adapter connected nothing else ever calls obd_data_set_speed().
+static void atz_synth_rpm_inject(void)
+{
+    static int64_t s_next_us = 0;
+    const int64_t now = esp_timer_get_time();
+    if (now < s_next_us) {
+        return;   // hold the previous value: a real ELM327 also only refreshes every ~100 ms
+    }
+    s_next_us = now + (1000000 / ATZ_SYNTH_FEED_HZ);
+
+    const int64_t period_us = (int64_t)ATZ_SYNTH_PERIOD_MS * 1000;
+    const int64_t half_us   = period_us / 2;
+    const int64_t phase     = now % period_us;
+    int32_t ratio;
+    if (phase < half_us) {
+        ratio = (int32_t)(phase * 100 / half_us);             // 0 -> 100
+    } else {
+        ratio = (int32_t)((2 * half_us - phase) * 100 / half_us); // 100 -> 0
+    }
+
+    const uint16_t rpm = (uint16_t)((int32_t)ATZ_SYNTH_PEAK * ratio / 100);
+    // Keep speed loosely consistent with rpm so calculate_gear() yields a sane gear.
+    const uint16_t spd = (uint16_t)(rpm / 50);
+
+    obd_data_rpm_override_set(true, rpm);
+    obd_data_set_speed((uint8_t)spd);
+}
