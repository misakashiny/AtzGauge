+// Why: this firmware has no on-device perf endpoint (the xiaozhi slave build has /perf).
+// Without a counter there is no way to tell whether a smoothness change actually helped --
+// "it feels smoother" is not evidence.
+//
+// TWO different numbers matter, and conflating them is a trap:
+//   ui_updates/s -- how often a gauge value is written INTO a widget. Measures the data path.
+//   frames/s     -- how often the panel is ACTUALLY driven. Measures what the eye sees.
+// Interpolation can lift the first to ~50/s while the second stays at ~10/s (e.g. because the
+// SPI transfer is the bottleneck, or LVGL coalesces several writes into one render pass).
+// The user-visible smoothness is bounded by frames/s, so that is the number to optimise.
+//
+// frames/s is derived from flush-callback traffic: every lvgl_flush_cb() call covers one
+// horizontal band of the dirty area, so a full-screen repaint at 40-line buffers produces
+// ~9 calls. Summing the band heights gives "rows pushed per second"; dividing by the panel
+// height converts that into "full-screen-equivalents per second", which is directly
+// comparable to a frame rate regardless of how LVGL chunks the render.
+static volatile uint32_t s_atz_ui_push = 0;
+static volatile uint32_t s_atz_flush_area = 0;      // pixels pushed since last report
+static volatile uint32_t s_atz_flush_calls = 0;     // flush_cb invocations since last report
+static volatile uint32_t s_atz_flush_busy_us = 0;   // accumulated time waiting for DMA
+
+void atz_perf_ui_push(void)
+{
+    s_atz_ui_push++;
+}
+
+// Called from lvgl_flush_cb (render path) and from notify_lvgl_flush_ready (ISR-adjacent DMA done).
+void atz_perf_flush_note(uint16_t w, uint16_t h)
+{
+    s_atz_flush_area += (uint32_t)w * (uint32_t)h;
+    s_atz_flush_calls++;
+}
+
+static void atz_perf_report_cb(void *arg)
+{
+    (void)arg;
+    static uint32_t last_push = 0, last_area = 0, last_calls = 0;
+    const uint32_t now_push  = s_atz_ui_push;
+    const uint32_t now_area  = s_atz_flush_area;
+    const uint32_t now_calls = s_atz_flush_calls;
+    const uint32_t d_push    = now_push  - last_push;
+    const uint32_t d_area    = now_area  - last_area;
+    const uint32_t d_calls   = now_calls - last_calls;
+    last_push  = now_push;
+    last_area  = now_area;
+    last_calls = now_calls;
+
+    // Pixels pushed per 2 s, expressed as fill-rate and as full-screen-equivalents.
+    const float px_per_s     = d_area / 2.0f;
+    const float full_frames  = (float)d_area / (float)(LCD_H_RES * LCD_V_RES) / 2.0f;
+
+    // How many refresh periods were even available, i.e. the ceiling imposed by the
+    // display refresh timer (LV_DISP_DEF_REFR_PERIOD / adaptive lv_timer_set_period).
+    // full_frames/s divided by this ceiling gives "how much of the offered budget we used".
+    uint32_t refr_period_ms = 0;
+    lv_disp_t *d = lv_disp_get_default();
+    if (d) {
+        lv_timer_t *rt = _lv_disp_get_refr_timer(d);
+        if (rt) refr_period_ms = rt->period;
+    }
+
+    ESP_LOGI("AtzPerf",
+             "ui=%0.1f/s flush=%0.1f/s px/s=%.0f frames/s=%.1f (ceil=%0.1f/s @%ums) dirty_px=%u free_sram=%u",
+             d_push / 2.0f, d_calls / 2.0f, px_per_s, full_frames,
+             refr_period_ms ? (2000.0f / refr_period_ms) : 0.0f, (unsigned)refr_period_ms,
+             (unsigned)(d_area / 2), (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL));
+}
