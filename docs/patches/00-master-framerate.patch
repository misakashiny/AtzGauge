+// Smooth one binding's displayed value toward its target.
+// Step sizing is scaled to the binding's own span, so the same code feels right on a
+// 0-8000 rpm arc and on a 0-100 % bar: a gap larger than 1 % of full scale closes by half
+// per tick (snappy), smaller gaps creep by one unit (no visible stepping). Called from
+// my_timerMain at the theme page's 16 ms refresh, i.e. roughly 62 times a second.
+static int32_t theme_anim_step(int32_t shown, int32_t target, int32_t span)
+{
+    int32_t diff = target - shown;
+    if (diff == 0) {
+        return shown;
+    }
+    int32_t ad = (diff > 0) ? diff : -diff;
+    int32_t thresh = span / 100;
+    if (thresh < 2) {
+        thresh = 2;
+    }
+    int32_t step = (ad > thresh) ? (ad / 2) : 1;
+    if (step < 1) {
+        step = 1;
+    }
+    if (step > ad) {
+        step = ad;
+    }
+    return shown + ((diff > 0) ? step : -step);
+}
